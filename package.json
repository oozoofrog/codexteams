{
  "name": "codexteams",
  "version": "0.3.0",
  "description": "Project teams, explicit model routing, durable tasks and usage tracking inside Pi.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./src/index.ts"] },
  "bin": { "codexteams": "./bin/codexteams.mjs" },
  "files": ["bin", "src", "docs", "scripts", "README.md"],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:load": "node scripts/smoke-load.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2",
    "@earendil-works/pi-ai": ">=1.4.0 <2",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
